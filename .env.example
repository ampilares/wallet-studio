# Base network: mainnet (8453) | sepolia (84532); testnet aliases sepolia
BUNDLER_NETWORK=sepolia

# Execution mode: simulation | live
BUNDLER_MODE=simulation

# Primary RPC (Alchemy recommended). Falls back to public RPC if unset.
RPC_URL=
RPC_URL_SECONDARY=
WS_URL=

# Optional Alchemy key — used to build provider URLs when RPC_URL is empty
ALCHEMY_API_KEY=

# Unique wallet encryption passphrase (at least 16 characters; required for key operations)
WALLET_PASSPHRASE=

# Parallel workers for bundle execution
MAX_CONCURRENCY=5

# Minimum ETH to keep on each wallet for gas (ether units)
MIN_GAS_ETH=0.002

# Slippage bps for swaps (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100

# Leave empty for ./data/base-mainnet or ./data/base-sepolia, selected by network
DATA_DIR=

# Optional direct submission to the Base sequencer; standard RPC is the default
USE_SEQUENCER=false
# Optional override; defaults to network sequencer URL from docs
SEQUENCER_URL=

# Base mainnet startup requires these exact canonical deployments. Sepolia values
# must come from the rehearsal deployment and are never accepted for mainnet.
DEX_ROUTER_ADDRESS=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24
WETH_ADDRESS=0x4200000000000000000000000000000000000006

# Garlic deployment bindings used by the guarded CONTRACT_CALL presets.
GARLIC_FACTORY_ADDRESS=
GARLIC_BUY_ADAPTER_ADDRESS=

# A live mainnet bundle is still refused without a fresh matching dry run.
# Set this only for the approved broadcast session, then unset it.
MAINNET_SEND_ENABLED=false

# Optional standalone dashboard vault override. Empty preserves ./data/studio.
# Use an absolute private path outside cloud-synced folders if relocating it.
# Existing vaults are not moved automatically; this is separate from CLI DATA_DIR.
STUDIO_DATA_DIR=

# Optional dedicated Wallet Studio providers. A secondary is used only when the
# primary read endpoint fails; every connection is checked against the chain ID.
STUDIO_BASE_SEPOLIA_RPC_URL=
STUDIO_BASE_SEPOLIA_RPC_URL_SECONDARY=
STUDIO_BASE_MAINNET_RPC_URL=
STUDIO_BASE_MAINNET_RPC_URL_SECONDARY=

# BTC Genesis Miners: see GENESIS_MINT.md. Put the Base mainnet Alchemy HTTPS
# URL above, not in CLI RPC_URL. Do not commit the real .env or share its key.
# Restart Studio after changes; MAINNET_SEND_ENABLED is the separate send gate.
