# Base network: mainnet (8453) | sepolia (84532); testnet aliases sepolia
BUNDLER_NETWORK=sepolia

# Execution mode: simulation | live
BUNDLER_MODE=simulation

# Primary RPC (Alchemy recommended). Falls back to public RPC if unset.
RPC_URL=
RPC_URL_SECONDARY=
WS_URL=

# Optional Alchemy key — used to build provider URLs when RPC_URL is empty
ALCHEMY_API_KEY=

# Unique wallet encryption passphrase (at least 16 characters; required for key operations)
WALLET_PASSPHRASE=

# Parallel workers for bundle execution
MAX_CONCURRENCY=5

# Minimum ETH to keep on each wallet for gas (ether units)
MIN_GAS_ETH=0.002

# Slippage bps for swaps (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100

# Leave empty for ./data/base-mainnet or ./data/base-sepolia, selected by network
DATA_DIR=

# Optional direct submission to the Base sequencer; standard RPC is the default
USE_SEQUENCER=false
# Optional override; defaults to network sequencer URL from docs
SEQUENCER_URL=

# Optional verified live DEX (Uniswap V2-compatible) on the selected network
# DEX_ROUTER_ADDRESS=0x...
# WETH_ADDRESS=0x...
